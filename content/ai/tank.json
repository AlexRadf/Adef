{
  "id": "tank",
  "reactionTicks": 7,
  "priority": [
    { "if": "selfCellUnsafe",           "do": "moveToSafe" },
    { "if": "stackMarkerActive",        "do": "moveToStack" },
    { "if": "soakNeeded",               "do": "moveToSoak" },
    { "if": "hasAuraStacks:scorched:2", "do": "cast:pentagram" },
    { "if": "selfBelowPct:45",          "do": "cast:pentagram" },
    { "if": "notThreatLeader",          "do": "cast:grapple" },
    { "if": "outOfMelee",               "do": "moveToBoss" },
    { "else": true,                     "do": "cast:superShotgun" },
    { "else": true,                     "do": "cast:shotgun" }
  ]
}
