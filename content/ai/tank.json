{
  "id": "tank",
  "reactionTicks": 7,
  "priority": [
    {
      "if": "selfCellUnsafe",
      "do": "moveToSafe"
    },
    {
      "if": "stackMarkerActive",
      "do": "moveToStack"
    },
    {
      "if": "soakNeeded",
      "do": "moveToSoak"
    },
    {
      "if": "facingParty",
      "do": "holdBossAway"
    },
    {
      "if": "partyAvgBelowPct:70",
      "do": "cast:pentagram"
    },
    {
      "if": "selfBelowPct:45",
      "do": "cast:pentagram"
    },
    {
      "if": "notThreatLeader",
      "do": "cast:grapple"
    },
    {
      "if": "targetHasAura:rattled",
      "do": "cast:grapple"
    },
    {
      "if": "resourceAbovePct:45",
      "do": "cast:superShotgun"
    },
    {
      "if": "outOfMelee",
      "do": "moveToBoss"
    },
    {
      "else": true,
      "do": "cast:shotgun"
    }
  ]
}
