{
  "id": "dps",
  "reactionTicks": 12,
  "priority": [
    {
      "if": "selfCellUnsafe",
      "do": "moveToSafe"
    },
    {
      "if": "stackMarkerActive",
      "do": "moveToStack"
    },
    {
      "if": "soakNeeded",
      "do": "moveToSoak"
    },
    {
      "if": "pickupReady",
      "do": "grabPickup"
    },
    {
      "if": "bossCastingInterruptible",
      "do": "cast:lightning"
    },
    {
      "if": "ultimateReady",
      "do": "cast:quad"
    },
    {
      "if": "targetHasAura:cracked",
      "do": "cast:lightning"
    },
    {
      "if": "resourceAbovePct:45",
      "do": "cast:rocket"
    },
    {
      "else": true,
      "do": "cast:nailgun"
    }
  ]
}
