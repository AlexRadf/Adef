{
  "id": "healer",
  "reactionTicks": 9,
  "priority": [
    {
      "if": "selfCellUnsafe",
      "do": "moveToSafe"
    },
    {
      "if": "stackMarkerActive",
      "do": "moveToStack"
    },
    {
      "if": "soakNeeded",
      "do": "moveToSoak"
    },
    {
      "if": "allyHasDispellable",
      "do": "cast:biosuit"
    },
    {
      "if": "partyAvgBelowPct:62",
      "do": "cast:megahealth"
    },
    {
      "if": "allyBelowPct:45",
      "do": "cast:medkit"
    },
    {
      "if": "allyHasAura:regenerating",
      "do": "cast:biosuit"
    },
    {
      "if": "resourceAbovePct:45",
      "do": "cast:medkit"
    },
    {
      "else": true,
      "do": "cast:stimpack"
    }
  ]
}
